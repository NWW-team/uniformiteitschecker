  <section class="rhc-paneel" id="paneel-{{ f.id }}" data-familie="{{ f.id }}" data-naam="{{ f.naam }}" data-aantal="{{ f.aantal }}" data-datum="{{ f.datum }}"
           {% if tabs %}role="tabpanel" aria-labelledby="tab-{{ f.id }}"{% endif %}>
    <div class="rhc-paneelkop">
      <h2>{{ f.naam }}</h2>
      {% if f.inleiding %}<p class="rhc-inleiding">{{ f.inleiding }}</p>{% endif %}
      <dl class="rhc-meta">
        <div><dt>Familie</dt><dd>{{ f.id }}</dd></div>
        <div><dt>Gecontroleerd</dt><dd>{{ f.datum }}</dd></div>
        <div><dt>Pagina's</dt><dd>{{ f.aantal_paginas }}</dd></div>
        <div><dt>Signalen</dt><dd>{{ f.aantal }}</dd></div>
      </dl>
    </div>

    {% if f.waarschuwingen %}
    <div class="rhc-waarschuwing">
      <strong>Let op bij het lezen van dit rapport</strong>
      <ul>
        {% for w in f.waarschuwingen %}<li>{{ w }}</li>{% endfor %}
      </ul>
    </div>
    {% endif %}

    {% if not f.aantal %}
    <div class="rhc-leeg">
      <h3>Geen afwijkingen gevonden</h3>
      <p>
        Op {{ f.aantal_paginas }} pagina's van de familie <em>{{ f.id }}</em> week niets
        af van wat de zusterpagina's zeggen. Dat betekent niet dat de pagina's
        foutloos zijn &mdash; alleen dat deze controle niets aantrof.
      </p>
    </div>
    {% else %}
    <ul class="rhc-tegels">
      {% for g in f.groepen %}
      <li>
        <a class="rhc-tegel rhc-{{ g.klasse }}" href="#groep-{{ f.id }}-{{ g.klasse }}">
          <span class="rhc-tegel__getal">{{ g.aantal }}</span>
          <span class="rhc-tegel__label">{{ g.titel }}</span>
        </a>
      </li>
      {% endfor %}
    </ul>

    <div class="rhc-zoek" hidden>
      <label class="utrecht-form-label" for="zoek-{{ f.id }}">Zoek op land of onderwerp</label>
      <div class="rhc-zoek__veld">
        <svg class="rhc-zoek__icoon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/></svg>
        <input type="search" class="utrecht-textbox rhc-text-input" id="zoek-{{ f.id }}" data-zoek="{{ f.id }}" placeholder="bijvoorbeeld duitsland">
      </div>
      <p class="rhc-zoek__status" data-status="{{ f.id }}" aria-live="polite"></p>
    </div>

    {% for g in f.groepen %}
    <section class="rhc-groep" id="groep-{{ f.id }}-{{ g.klasse }}">
      <div class="rhc-kopregel">
        <h3>{{ g.titel }}</h3>
        <span class="rhc-aantal">{{ g.aantal }}</span>
      </div>
      <p class="rhc-groeptoelichting">{{ g.toelichting }}</p>

      {% for c in g.categorieen %}
      <section class="rhc-categorie">
        <div class="rhc-kopregel">
          <h4>{{ c.naam }}</h4>
          <span class="rhc-aantal">{{ c.bevindingen|length }}</span>
        </div>

        {% for b in c.bevindingen %}
        <details class="rhc-bevinding rhc-{{ g.klasse }}" data-id="{{ b.id }}" data-zoektekst="{{ b.zoek }}">
          <summary>
            <h5>{{ b.titel }}</h5>
            <span class="rhc-chips">
              <span class="rhc-chip rhc-soort-{{ b.soort }}">{{ b.soort }}</span>
              {% if b.paginas|length > 1 %}
              <span class="rhc-chip rhc-neutraal">{{ b.paginas|length }} pagina's</span>
              {% endif %}
              {% if b.telling %}
              <span class="rhc-chip rhc-neutraal">{{ b.telling.eens }} van {{ b.telling.n }} eens</span>
              {% endif %}
            </span>
          </summary>

          <div class="rhc-bevinding__inhoud">
            <div class="rhc-bewijs">
              <div class="rhc-kolom rhc-afwijkend">
                <h6>Wijkt af {% if b.paginas|length > 1 %}({{ b.paginas|length }} pagina's){% endif %}</h6>
                <ul>
                  {% for p in b.paginas %}
                  {% set waarde = p.waarden|join(" · ") %}
                  <li data-url="{{ p.url }}" data-bewijs="{{ p.bewijs }}"><span class="rhc-land"><a class="utrecht-link rhc-link" href="{{ p.url }}" title="{{ p.url }}" target="_blank" rel="noopener noreferrer">{{ p.variant }}</a></span><span class="rhc-waarde{% if waarde|length > 24 %} rhc-waarde--tekst{% endif %}">{{ waarde }}</span></li>
                  {% endfor %}
                </ul>
              </div>
              <div class="rhc-kolom">
                <h6>Staat elders</h6>
                <ul>
                  {% for z in b.zusters %}
                  <li><span class="rhc-land">{{ z.variant }}</span><span class="rhc-waarde{% if z.waarde|length > 24 %} rhc-waarde--tekst{% endif %}">{{ z.waarde }}</span></li>
                  {% endfor %}
                </ul>
              </div>
            </div>

            {% if b.toelichting %}<p class="rhc-toelichting">{{ b.toelichting }}</p>{% endif %}

            <p class="rhc-actie"><span>Actie:</span> {{ b.voorgestelde_actie }}</p>
          </div>
        </details>
        {% endfor %}
      </section>
      {% endfor %}
    </section>
    {% endfor %}
    {% endif %}
  </section>
