<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Uniformiteitssignalen NederlandWereldwijd</title>
<style>{{ stijl | safe }}</style>
</head>
<body class="{{ thema }}">
<a class="rhc-skiplink" href="#inhoud">Naar de inhoud</a>
{{ sitekop | safe }}

<div class="rhc-blad">
  <header class="rhc-kop">
    <p class="rhc-eyebrow">Uniformiteitschecker &middot; webredactie</p>
    <h1>Uniformiteitssignalen</h1>
    <p class="rhc-inleiding">
      Pagina's over hetzelfde onderwerp horen hetzelfde te zeggen. Waar &eacute;&eacute;n
      pagina afwijkt van de rest, staat dat hieronder &mdash; met de vindplaats en het
      bewijs erbij. De checker bepaalt niet wat juist is; dat doet de webredactie of de
      kenniseigenaar.
    </p>
    <details class="rhc-methode">
      <summary>Hoe de checker afwijkingen vindt</summary>
      <ul>
        <li>Hij legt pagina's over hetzelfde onderwerp naast elkaar &mdash; bijvoorbeeld
          dezelfde tarievenlijst of hetzelfde stappenplan voor alle landen (de
          &ldquo;zusterpagina's&rdquo;).</li>
        <li>Hij telt zelf uit wat de meeste zusterpagina's zeggen; die meerderheid geldt
          als de norm, er wordt niets vooraf als &ldquo;juist&rdquo; ingevoerd.</li>
        <li>Pas als minstens 80% van de zusterpagina's hetzelfde zegt, gebruikt de checker
          dat als norm &mdash; bij bijvoorbeeld een verdeling van 50/50 is er geen duidelijke
          norm en meldt hij niets, om vals alarm te voorkomen.</li>
        <li>Zegt een pagina iets anders dan die norm, dan is dat een afwijking en komt die
          hieronder als signaal te staan.</li>
        <li>Bij elk signaal staat het bewijs erbij: de vindplaats en de afwijkende waarde
          naast de waarde op de andere pagina's, zodat je het zelf in een paar seconden
          kunt nakijken.</li>
      </ul>
    </details>
  </header>

  {% if families|length > 1 %}
  <nav class="rhc-tabs" id="tabbalk" aria-label="Onderwerpen" hidden>
    <div role="tablist">
      {% for f in families %}
      <button type="button" role="tab" id="tab-{{ f.id }}" aria-controls="paneel-{{ f.id }}"
              aria-selected="{{ 'true' if loop.first else 'false' }}"
              tabindex="{{ '0' if loop.first else '-1' }}">
        {{ f.naam }} <span class="rhc-aantal">{{ f.aantal }}</span>
      </button>
      {% endfor %}
    </div>
  </nav>
  {% endif %}

  <main id="inhoud">
  {% for f in families %}
  <section class="rhc-paneel" id="paneel-{{ f.id }}" data-familie="{{ f.id }}"
           {% if families|length > 1 %}role="tabpanel" aria-labelledby="tab-{{ f.id }}"{% endif %}>
    <div class="rhc-paneelkop">
      <h2>{{ f.naam }}</h2>
      {% if f.inleiding %}<p class="rhc-inleiding">{{ f.inleiding }}</p>{% endif %}
      <dl class="rhc-meta">
        <div><dt>Familie</dt><dd>{{ f.id }}</dd></div>
        <div><dt>Gecontroleerd</dt><dd>{{ f.datum }}</dd></div>
        <div><dt>Pagina's</dt><dd>{{ f.aantal_paginas }}</dd></div>
        <div><dt>Signalen</dt><dd>{{ f.aantal }}</dd></div>
      </dl>
    </div>

    {% if f.waarschuwingen %}
    <div class="rhc-waarschuwing">
      <strong>Let op bij het lezen van dit rapport</strong>
      <ul>
        {% for w in f.waarschuwingen %}<li>{{ w }}</li>{% endfor %}
      </ul>
    </div>
    {% endif %}

    {% if not f.aantal %}
    <div class="rhc-leeg">
      <h3>Geen afwijkingen gevonden</h3>
      <p>
        Op {{ f.aantal_paginas }} pagina's van de familie <em>{{ f.id }}</em> week niets
        af van wat de zusterpagina's zeggen. Dat betekent niet dat de pagina's
        foutloos zijn &mdash; alleen dat deze controle niets aantrof.
      </p>
    </div>
    {% else %}
    <ul class="rhc-tegels">
      {% for g in f.groepen %}
      <li>
        <a class="rhc-tegel rhc-{{ g.klasse }}" href="#groep-{{ f.id }}-{{ g.klasse }}">
          <span class="rhc-tegel__getal">{{ g.aantal }}</span>
          <span class="rhc-tegel__label">{{ g.titel }}</span>
        </a>
      </li>
      {% endfor %}
    </ul>

    <div class="rhc-zoek" hidden>
      <label class="utrecht-form-label" for="zoek-{{ f.id }}">Zoek op land of onderwerp</label>
      <input type="search" class="utrecht-textbox rhc-text-input" id="zoek-{{ f.id }}" data-zoek="{{ f.id }}" placeholder="bijvoorbeeld duitsland">
      <p class="rhc-zoek__status" data-status="{{ f.id }}" aria-live="polite"></p>
    </div>

    {% for g in f.groepen %}
    <section class="rhc-groep" id="groep-{{ f.id }}-{{ g.klasse }}">
      <div class="rhc-kopregel">
        <h3>{{ g.titel }}</h3>
        <span class="rhc-aantal">{{ g.aantal }}</span>
      </div>
      <p class="rhc-groeptoelichting">{{ g.toelichting }}</p>

      {% for c in g.categorieen %}
      <section class="rhc-categorie">
        <div class="rhc-kopregel">
          <h4>{{ c.naam }}</h4>
          <span class="rhc-aantal">{{ c.bevindingen|length }}</span>
        </div>

        {% for b in c.bevindingen %}
        <details class="rhc-bevinding rhc-{{ g.klasse }}" data-zoektekst="{{ b.zoek }}">
          <summary>
            <h5>{{ b.titel }}</h5>
            <span class="rhc-chips">
              <span class="rhc-chip rhc-soort-{{ b.soort }}">{{ b.soort }}</span>
              {% if b.varianten|length > 1 %}
              <span class="rhc-chip rhc-neutraal">{{ b.varianten|length }} pagina's</span>
              {% endif %}
              {% if b.telling %}
              <span class="rhc-chip rhc-neutraal">{{ b.telling.eens }} van {{ b.telling.n }} eens</span>
              {% endif %}
            </span>
          </summary>

          <div class="rhc-bevinding__inhoud">
            <div class="rhc-bewijs">
              <div class="rhc-kolom rhc-afwijkend">
                <h6>Wijkt af {% if b.varianten|length > 1 %}({{ b.varianten|length }} pagina's){% endif %}</h6>
                <ul>
                  {% for v in b.varianten %}
                  <li><span class="rhc-land">{{ v.variant }}</span><span class="rhc-waarde{% if v.waarde|length > 24 %} rhc-waarde--tekst{% endif %}">{{ v.waarde }}</span></li>
                  {% endfor %}
                </ul>
              </div>
              <div class="rhc-kolom">
                <h6>Staat elders</h6>
                <ul>
                  {% for z in b.zusters %}
                  <li><span class="rhc-land">{{ z.variant }}</span><span class="rhc-waarde{% if z.waarde|length > 24 %} rhc-waarde--tekst{% endif %}">{{ z.waarde }}</span></li>
                  {% endfor %}
                </ul>
              </div>
            </div>

            {% if b.toelichting %}<p class="rhc-toelichting">{{ b.toelichting }}</p>{% endif %}

            <div class="rhc-paginas">
              {% for u in b.urls %}<a class="utrecht-link rhc-link" href="{{ u }}" target="_blank" rel="noopener noreferrer">{{ u }}</a>{% endfor %}
            </div>

            <p class="rhc-actie"><span>Actie:</span> {{ b.voorgestelde_actie }}</p>
          </div>
        </details>
        {% endfor %}
      </section>
      {% endfor %}
    </section>
    {% endfor %}
    {% endif %}
  </section>
  {% endfor %}
  </main>

  <footer>
    Gegenereerd door de uniformiteitschecker op basis van de publieke sitemap van
    nederlandwereldwijd.nl. De checker signaleert en lost niets op: een afwijking kan ook
    een legitiem landspecifiek geval zijn. Verifieer altijd via de vindplaats voordat je
    iets wijzigt.
  </footer>
</div>

<script>
(function () {
  var panelen = Array.prototype.slice.call(document.querySelectorAll(".rhc-paneel"));
  var tabbalk = document.getElementById("tabbalk");

  // Tabbladen: zonder script staan de panelen onder elkaar.
  if (tabbalk) {
    var tabs = Array.prototype.slice.call(tabbalk.querySelectorAll('[role="tab"]'));
    var toon = function (id, focus) {
      tabs.forEach(function (t) {
        var actief = t.id === "tab-" + id;
        t.setAttribute("aria-selected", actief ? "true" : "false");
        t.tabIndex = actief ? 0 : -1;
        if (actief && focus) t.focus();
      });
      panelen.forEach(function (p) { p.hidden = p.dataset.familie !== id; });
      try { history.replaceState(null, "", "#" + id); } catch (e) {}
    };
    tabs.forEach(function (t, i) {
      t.addEventListener("click", function () { toon(t.id.slice(4)); });
      t.addEventListener("keydown", function (e) {
        var d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        toon(tabs[(i + d + tabs.length) % tabs.length].id.slice(4), true);
      });
    });
    tabbalk.hidden = false;
    var start = location.hash.slice(1);
    var bekend = panelen.some(function (p) { return p.dataset.familie === start; });
    toon(bekend ? start : panelen[0].dataset.familie);
  }

  // Zoeken op land of onderwerp: verbergt wat niet past.
  document.querySelectorAll(".rhc-zoek").forEach(function (blok) {
    blok.hidden = false;
    var invoer = blok.querySelector("input");
    var status = blok.querySelector(".rhc-zoek__status");
    var paneel = blok.closest(".rhc-paneel");
    invoer.addEventListener("input", function () {
      var q = invoer.value.trim().toLowerCase();
      var zichtbaar = 0;
      paneel.querySelectorAll(".rhc-bevinding").forEach(function (b) {
        var raak = !q || b.dataset.zoektekst.indexOf(q) !== -1;
        b.hidden = !raak;
        if (raak) zichtbaar++;
      });
      paneel.querySelectorAll(".rhc-categorie").forEach(function (c) {
        var heeft = c.querySelector(".rhc-bevinding:not([hidden])") !== null;
        c.hidden = !heeft;
      });
      paneel.querySelectorAll(".rhc-groep").forEach(function (g) {
        g.hidden = !g.querySelector(".rhc-categorie:not([hidden])");
      });
      status.textContent = q
        ? (zichtbaar ? zichtbaar + " signalen gevonden voor “" + invoer.value.trim() + "”"
                     : "Geen signalen gevonden voor “" + invoer.value.trim() + "”")
        : "";
    });
  });
})();
</script>
</body>
</html>
